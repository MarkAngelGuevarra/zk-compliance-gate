;; Read-only query circuit — verifies the caller's eligibility status.
;; No proof required. No ledger mutation. Pure ledger lookup.
;; ─────────────────────────────────────────────────────────────────────────────

(circuit getVerificationStatus
  ;; ── Public Inputs ───────────────────────────────────────────────────────────
  (public-inputs)

  ;; ── Witnesses ───────────────────────────────────────────────────────────────
  (witnesses)

  ;; ── Constraints ─────────────────────────────────────────────────────────────
  (constraints
    ;; Lookup caller's eligibility in the verifications map
    (let status (ledger-map-lookup verifications (own-public-key)))
    ;; Return false (default) if not found — no constraint violation
